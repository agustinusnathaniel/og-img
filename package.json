{
  "name": "nextarter-chakra",
  "version": "1.1.2",
  "private": true,
  "author": "agustinusnathaniel",
  "scripts": {
    "build": "next build",
    "build:turbo": "pnpm turbo build",
    "check:turbo": "pnpm turbo ultracite:check type:check",
    "dev": "next dev",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "cp node_modules/@fontsource-variable/geologica/files/geologica-latin-wght-normal.woff2 public/assets/fonts/geologica.woff2",
    "prepare": "husky",
    "push-release": "git push --follow-tags origin main",
    "release": "cross-env HUSKY=0 commit-and-tag-version",
    "start": "next start",
    "turbo": "pnpm dlx turbo@2.8.19",
    "type:check": "tsc --noEmit",
    "ultracite:check": "ultracite check",
    "ultracite:fix": "ultracite fix",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "takumi-js": "^2.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "commit-and-tag-version": "^13.1.2",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "ultracite": "7.10.6"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    }
  }
}
